{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floor-ceiling.example/contracts/forecast-result.v3.json",
  "title": "Floor and Ceiling v2 combined forecast result",
  "description": "A complete PPR forecast result. XGBoost v2 supplies p15, p50, and p85 for every modeled position. ffsimulator values remain diagnostic fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "uploadId", "state", "metadata", "modelStatus", "rows"],
  "properties": {
    "schemaVersion": { "const": "forecast-result.v3" },
    "runId": { "type": "string", "pattern": "^run_[A-Za-z0-9-]{8,128}$" },
    "uploadId": { "type": "string", "pattern": "^upload_[A-Za-z0-9-]{8,128}$" },
    "state": { "const": "Complete" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["season", "week", "scoringFormat", "scoringContractVersion", "metricDefinitionVersion", "simulationCount", "seed", "modelRelease", "featureVersion", "modelTarget", "modelObjective", "xgboostVersion", "modelArtifactVersion", "modelTrainingSeasons", "validationResult", "predictionCallCount", "quantileCrossingCount", "quantileCrossingPlayerIds", "negativePredictionCount", "negativePredictionPlayerIds", "quantileLevels", "rangePolicyVersion", "inferenceEndpoint", "rankReferenceSnapshot", "sourceInputRevision", "createdAt", "completedAt", "acceptedRowCount", "excludedRowCount", "positionCounts", "outputRowCount", "rankRule", "rankSourceOrder"],
      "properties": {
        "season": { "type": "integer", "minimum": 2020, "maximum": 2100 },
        "week": { "type": "integer", "minimum": 1, "maximum": 18 },
        "scoringFormat": { "type": "string", "const": "PPR" },
        "scoringContractVersion": { "type": "string", "const": "ppr_v1" },
        "metricDefinitionVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
        "simulationCount": { "type": "integer", "minimum": 100, "maximum": 10000 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "modelRelease": { "type": "string", "const": "forecast-ppr-v2" },
        "featureVersion": { "type": "string", "const": "fbg_rank_projection_v2" },
        "modelTarget": { "type": "string", "const": "actual_score" },
        "modelObjective": { "type": "string", "const": "reg:quantileerror" },
        "xgboostVersion": { "type": "string", "const": "3.4.1" },
        "modelArtifactVersion": { "type": "string", "const": "xgb_v2_quantile_20260907" },
        "modelTrainingSeasons": { "type": "array", "items": { "type": "integer" }, "minItems": 3, "maxItems": 3 },
        "validationResult": {
          "type": "object",
          "additionalProperties": false,
          "required": ["walkForward", "validationWeeks", "selectedModelRecords"],
          "properties": {
            "walkForward": { "const": true },
            "validationWeeks": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 18 }, "minItems": 4, "maxItems": 4 },
            "selectedModelRecords": { "type": "integer", "const": 8 }
          }
        },
        "predictionCallCount": { "type": "integer", "minimum": 1, "maximum": 4 },
        "quantileCrossingCount": { "type": "integer", "const": 0 },
        "quantileCrossingPlayerIds": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
        "negativePredictionCount": { "type": "integer", "const": 0 },
        "negativePredictionPlayerIds": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
        "quantileLevels": { "type": "array", "prefixItems": [{ "const": 0.15 }, { "const": 0.5 }, { "const": 0.85 }], "minItems": 3, "maxItems": 3 },
        "rangePolicyVersion": { "type": "string", "const": "direct_xgb_quantiles_v1" },
        "inferenceEndpoint": { "type": "string", "const": "/v2/models/predict" },
        "rankReferenceSnapshot": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sourceInputRevision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "acceptedRowCount": { "type": "integer", "minimum": 0, "maximum": 50000 },
        "excludedRowCount": { "type": "integer", "minimum": 0, "maximum": 50000 },
        "positionCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["QB", "RB", "WR", "TE"],
          "properties": {
            "QB": { "type": "integer", "minimum": 0, "maximum": 50000 },
            "RB": { "type": "integer", "minimum": 0, "maximum": 50000 },
            "WR": { "type": "integer", "minimum": 0, "maximum": 50000 },
            "TE": { "type": "integer", "minimum": 0, "maximum": 50000 }
          }
        },
        "outputRowCount": { "type": "integer", "minimum": 1, "maximum": 50000 },
        "rankRule": { "type": "string", "minLength": 1, "maxLength": 256 },
        "rankSourceOrder": { "const": "preserved" }
      }
    },
    "modelStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ffsimulator", "xgb"],
      "properties": {
        "ffsimulator": { "$ref": "#/$defs/modelStatus" },
        "xgb": { "$ref": "#/$defs/modelStatus" }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "items": { "$ref": "#/$defs/resultRow" }
    }
  },
  "$defs": {
    "modelStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["complete", "failed"] },
        "release": { "type": "string", "maxLength": 128 },
        "featureVersion": { "type": "string", "maxLength": 128 },
        "predictionCount": { "type": "integer", "minimum": 0, "maximum": 50000 },
        "predictionCallCount": { "type": "integer", "minimum": 0, "maximum": 100 },
        "quantileCrossingCount": { "type": "integer", "minimum": 0, "maximum": 50000 },
        "quantileCrossingPlayerIds": { "type": "array", "items": { "type": "string" }, "maxItems": 50000 },
        "negativePredictionCount": { "type": "integer", "minimum": 0, "maximum": 50000 },
        "negativePredictionPlayerIds": { "type": "array", "items": { "type": "string" }, "maxItems": 50000 },
        "error": { "type": "string", "maxLength": 2000 }
      }
    },
    "resultRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stablePlayerId", "playerName", "position", "team", "opponent", "gameId", "season", "week", "sourceRowOrder", "ecr", "rankSd", "rankSdMatch", "csvProjection", "rawProjection", "ffsimMean", "ffsimP15", "ffsimP50", "ffsimP85", "ffsimZeroRate", "ffsimActiveRate", "xgbP15", "xgbP50", "xgbP85", "floor", "average", "median", "ceiling", "rangeWidth", "valueSources"],
      "properties": {
        "stablePlayerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "playerName": { "type": "string", "minLength": 1, "maxLength": 256 },
        "position": { "enum": ["QB", "RB", "WR", "TE"] },
        "team": { "type": "string", "minLength": 2, "maxLength": 4 },
        "opponent": { "type": "string", "minLength": 2, "maxLength": 4 },
        "gameId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "season": { "type": "integer" },
        "week": { "type": "integer" },
        "sourceRowOrder": { "type": "integer", "minimum": 1 },
        "ecr": { "type": "number", "exclusiveMinimum": 0 },
        "rankSd": { "type": "number", "minimum": 0.5 },
        "rankSdMatch": { "enum": ["exact", "nearest"] },
        "csvProjection": { "type": "number", "minimum": 0 },
        "rawProjection": { "type": "object", "additionalProperties": { "type": "string" } },
        "ffsimMean": { "type": "number", "minimum": 0 },
        "ffsimP15": { "type": "number", "minimum": 0 },
        "ffsimP50": { "type": "number", "minimum": 0 },
        "ffsimP85": { "type": "number", "minimum": 0 },
        "ffsimZeroRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "ffsimActiveRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "xgbP15": { "type": "number", "minimum": 0 },
        "xgbP50": { "type": "number", "minimum": 0 },
        "xgbP85": { "type": "number", "minimum": 0 },
        "floor": { "type": "number", "minimum": 0 },
        "average": { "type": "number", "minimum": 0 },
        "median": { "type": "number", "minimum": 0 },
        "ceiling": { "type": "number", "minimum": 0 },
        "rangeWidth": { "type": "number", "minimum": 0 },
        "valueSources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["floor", "average", "median", "ceiling"],
          "properties": {
            "floor": { "const": "XGBoost p15" },
            "average": { "const": "CSV PPR projection" },
            "median": { "const": "XGBoost p50" },
            "ceiling": { "const": "XGBoost p85" }
          }
        }
      }
    }
  }
}
